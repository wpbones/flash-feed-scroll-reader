msgctxt "block description"
msgid "A horizontal scrolling ticker of items from one or more RSS/Atom feeds."
msgstr "Un ticker a scorrimento orizzontale con gli elementi di uno o più feed RSS/Atom."

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "feed"
msgstr "feed"

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "rss"
msgstr "rss"

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "atom"
msgstr "atom"

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "ticker"
msgstr "ticker"

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "news"
msgstr "notizie"

#: public/blocks/ticker/block.json
msgctxt "block keyword"
msgid "marquee"
msgstr "scorrimento"
